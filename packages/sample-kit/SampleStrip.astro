---
/**
 * 맨 위 샘플 띠. 숨기거나 스크립트로 지우지 않는다. 모양은 사이트 CSS가 class로 정한다.
 * 화면낭독기의 영역 이동에서 빠지지 않게 이름 붙은 aside 랜드마크로 둔다(axe region). aside도 기본 display:block이라 모양은 div와 같다.
 */
interface Props { text: string; class?: string; label?: string }
const { text, class: className = 'top-strip', label = '샘플 안내' } = Astro.props;
---
<aside class={className} aria-label={label} data-sample-strip>{text}</aside>
