---
/**
 * 회사 소개(② Page). 시안의 about.html + history.html(#history) + access.html(#access)을 한 URL로 조립.
 * 내용·색·컴포넌트는 시안 그대로이고 원래 페이지 제목은 구역 머리(PartHead, h2)로 옮겼다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import LocalNav from '../components/LocalNav.astro';
import PartHead from '../components/PartHead.astro';
import Icon from '../components/Icon.astro';
import Notice from '../components/Notice.astro';
import site from '../data/site.json';
import { img } from '../lib/url';
const b = site.business;
const history = [
  { y: 2009, t: '설립' }, { y: 2014, t: '공장 이전' }, { y: 2018, t: '5축 가공기 도입' },
  { y: 2021, t: '품질경영시스템 인증 취득' }, { y: 2025, t: '3차원 측정기 추가' },
];
---
<BaseLayout
  frame="Page"
  current="about/"
  title="회사 소개 · 연혁·인증 · 오시는 길 | DORAM 도람정밀 (샘플)"
  description="정해진 공차를, 정해진 날짜에. 도람정밀의 대표 인사말, 회사 개요, 일하는 원칙, 연혁·인증, 오시는 길. (샘플 사이트, 가상 정보)"
>
  <PageHead crumbs={[{ label: '회사 소개' }]} title="정해진 공차를, 정해진 날짜에" />
  <LocalNav current="about/" items={[{ label: '회사 소개', href: 'about/' }, { label: '연혁·인증', href: 'about/#history' }, { label: '오시는 길', href: 'about/#access' }]} />

  <section class="section" data-component="Greeting"><div class="container"><div class="split">
    <figure class="split__media" data-reveal><img src={img('factory.svg')} alt="간판이 없는 단층 공장 건물 외관 일러스트" width="1600" height="900" loading="lazy" /><figcaption>공장 외관(일러스트). 실제 사진이 아닙니다.</figcaption></figure>
    <div class="split__text" data-reveal><span class="eyebrow">Message</span><h2 class="h2">대표 인사말</h2>
      <div class="greeting">
        <p>도람정밀은 자동화 설비 부품을 가공해 온 회사입니다. 저희가 가장 중요하게 여기는 것은 도면에 적힌 숫자와 약속한 납기입니다.</p>
        <p>가공이 어려운 형상은 견적 단계에서 먼저 말씀드리고, 바꿀 수 있는 부분을 함께 찾습니다.</p>
        <p>한 번 맡겨 주신 부품은 다음 주문에도 같은 품질로 나오도록 가공 조건과 검사 결과를 기록해 둡니다.</p>
        <div class="sign"><span class="sign-avatar" aria-hidden="true"><Icon name="user" /></span><span>도람정밀 대표 (가상 인물)</span></div>
      </div>
    </div>
  </div></div></section>

  <section class="section section--gray" data-component="CompanyOverview"><div class="container"><div class="grid">
    <div class="g-head" data-reveal><span class="eyebrow">Overview</span><h2 class="h2" style="margin-top:12px">회사 개요</h2><p class="muted small" style="margin-top:12px">표의 수치는 모두 가상입니다.</p></div>
    <div class="g-body" data-reveal><table class="info-table"><tbody>
      <tr><th scope="row">상호</th><td>{b.legalName}</td></tr>
      <tr><th scope="row">설립</th><td><span class="num">{b.established}</span>년</td></tr>
      <tr><th scope="row">인원</th><td><span class="num">{b.employees}</span>명</td></tr>
      <tr><th scope="row">공장 면적</th><td><span class="num">{b.factoryArea}</span></td></tr>
      <tr><th scope="row">주요 업종</th><td>자동화 설비, 반도체 장비, 검사 장비 부품</td></tr>
      <tr><th scope="row">소재지</th><td>{b.address}</td></tr>
    </tbody></table></div>
  </div></div></section>

  <section class="section" data-component="Principles"><div class="container">
    <div class="sec-head" data-reveal><span class="eyebrow">Principles</span><h2 class="h2">일하는 원칙</h2></div>
    <div class="principles" data-reveal>
      <div class="principle"><span class="no">01</span><h3 class="h3">견적 전 가공성 검토</h3><p>도면을 받으면 가공 가능 여부와 바꿀 수 있는 부분을 견적 전에 먼저 알려 드립니다.</p></div>
      <div class="principle"><span class="no">02</span><h3 class="h3">첫 부품 전수 검사</h3><p>첫 번째로 가공한 부품은 도면의 모든 치수를 측정한 뒤 다음 가공으로 넘어갑니다.</p></div>
      <div class="principle"><span class="no">03</span><h3 class="h3">가공 조건 기록</h3><p>가공 조건과 검사 결과를 기록해 두어 다음 주문에도 같은 조건으로 가공합니다.</p></div>
    </div>
  </div></section>

  <PartHead id="history" eyebrow="History & Certification" title="연혁·인증" lead="2009년 설립 이후의 주요 변화와 보유 인증입니다. 모든 연도는 가상입니다." />
  <section class="section" data-component="Timeline"><div class="container"><div class="grid">
    <div class="g-head" data-reveal><span class="eyebrow">History</span><h3 class="h2" style="margin-top:12px">연혁</h3></div>
    <ol class="timeline g-body" data-reveal>
      {history.map((h) => <li><span class="y">{h.y}</span><div><p class="t">{h.t}</p></div></li>)}
    </ol>
  </div></div></section>
  <section class="section section--gray" data-component="CertList"><div class="container"><div class="grid">
    <div class="g-head" data-reveal><span class="eyebrow">Certification</span><h3 class="h2" style="margin-top:12px">인증</h3><p class="muted small" style="margin-top:12px">인증은 글자로만 표기합니다. 인증기관의 로고는 쓰지 않습니다.</p></div>
    <div class="g-body" data-reveal><div class="cert-list">
      <div class="cert"><span class="k">CERT 01</span><span class="v">품질경영시스템 인증</span><p class="small muted"><span class="num">2021</span>년 취득, <span class="num">2025</span>년 갱신 심사 완료(가상)</p></div>
      <div class="cert"><span class="k">COPY</span><span class="v">인증서 사본</span><p class="small muted">거래처 요청 시 견적 문의로 알려 주시면 제공합니다(가상).</p></div>
    </div></div>
  </div></div></section>

  <PartHead id="access" eyebrow="Location" title="오시는 길" lead="방문 전에 전화로 일정을 알려 주세요. 주소와 약도는 모두 가상입니다." />
  <section class="section" data-component="AccessMap"><div class="container"><div class="grid">
    <figure class="map-figure g-map" data-reveal><img src={img('map.svg')} alt="산업로와 기술로 사이에 있는 도람정밀 위치를 표시한 약도 일러스트" width="1200" height="640" loading="lazy" /><figcaption>약도 일러스트입니다. 실제 지도·실제 위치가 아닙니다.</figcaption></figure>
    <div class="g-side" data-reveal data-component="AccessInfo">
      <h3 class="h2" style="margin-bottom:var(--sp-5)">찾아오시는 길</h3>
      <table class="info-table"><tbody>
        <tr><th scope="row">주소</th><td>{b.address}</td></tr>
        <tr><th scope="row">운영 시간</th><td>{b.hours}<br /><span class="muted small">{b.closed}</span></td></tr>
        <tr><th scope="row">전화</th><td><a class="num" href="#" data-sample-notice="external" data-track="tel_click">{b.tel}</a></td></tr>
        <tr><th scope="row">이메일</th><td><span class="num">{b.email}</span></td></tr>
      </tbody></table>
      <Notice icon="map-pin" style="margin-top:var(--sp-5)" reveal={false}><p>공장 방문과 제품 인수는 사전에 일정을 정한 뒤 진행합니다(가상 안내).</p></Notice>
    </div>
  </div></div></section>
  <section class="section section--gray" data-component="AccessGuide"><div class="container"><div class="cards-2" data-reveal>
    <div class="aside-box"><h3 class="aside-box__title">자가용</h3><p class="small muted">고속도로 나들목에서 산업로 방향으로 나와 기술로 사거리에서 우회전합니다. 공장 앞에 방문객 주차 구역이 있습니다(가상).</p></div>
    <div class="aside-box"><h3 class="aside-box__title">대중교통</h3><p class="small muted">견본 정류장에서 내려 산업로를 따라 도보로 이동합니다(가상).</p></div>
  </div></div></section>
</BaseLayout>
