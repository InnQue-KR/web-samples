---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Notice from '../components/Notice.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
const b = site.business;
---
<BaseLayout frame="Page" current="quote/" title="견적 문의 | DORAM 도람정밀 (샘플)" description="도면과 수량을 알려 주시면 영업일 2일 안에 견적을 드립니다. (샘플 사이트: 실제로 전송되지 않습니다)">
  <PageHead crumbs={[{ label: '견적 문의' }]} title="견적 문의" lead="도면과 수량을 알려 주시면 영업일 2일 안에 견적을 드립니다." />
  <section class="section" data-component="QuoteLayout"><div class="container"><div class="quote-layout">
    <QuoteForm />
    <aside class="quote-aside" aria-label="견적 안내" data-component="QuoteAside">
      <div class="aside-box" data-component="ProcessSteps"><h2>처리 순서</h2>
        <ProcessSteps vertical steps={[
          { no: '01', title: '접수', text: '문의가 접수되면 확인 연락을 드립니다.' },
          { no: '02', title: '도면 검토', text: '도면을 받아 가공 가능 여부를 검토합니다.' },
          { no: '03', title: '견적서 발송', text: '영업일 2일 안에 견적서를 보냅니다.' },
          { no: '04', title: '발주 확정', text: '조건에 합의하시면 발주를 확정합니다.' },
        ]} />
      </div>
      <Notice icon="file-text" reveal={false}><div data-component="DrawingNotice"><p><strong>도면은 이메일로 받습니다</strong></p><p class="muted small" style="margin-top:4px">도면 파일은 문의 폼으로 받지 않습니다. 접수 확인 연락을 드린 뒤 이메일(<a class="num" href="#" data-sample-notice="external" data-track="mail_click">{b.email}</a>)로 보내 주세요. 이 양식에는 파일을 올리는 칸이 없습니다.</p></div></Notice>
      <div class="aside-box aside-box--gray"><h2>전화 상담</h2><p class="small muted">{b.hours}</p><p style="margin-top:8px"><a class="btn btn--outline" href="#" data-sample-notice="external" data-track="tel_click"><Icon name="phone" /><span class="num">{b.tel}</span></a></p></div>
    </aside>
  </div></div></section>
</BaseLayout>
