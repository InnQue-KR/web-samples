---
/** 별도 오류 화면(/company-01/404.html). 콘텐츠 URL 10개에 넣어 세지 않는다. */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { url } from '../lib/url';
---
<BaseLayout frame="Page" current="404" cta={false} title="페이지를 찾을 수 없습니다 | DORAM 도람정밀 (샘플)" description="주소가 바뀌었거나 없는 페이지입니다. (샘플 사이트)">
  <PageHead crumbs={[{ label: '페이지 없음' }]} title="페이지를 찾을 수 없습니다" lead="주소가 바뀌었거나 없는 페이지입니다. 아래에서 원하는 곳으로 이동해 주세요." />
  <section class="section"><div class="container" style="display:flex;flex-wrap:wrap;gap:var(--sp-3)">
    <a class="btn btn--primary" href={url()}>홈으로</a>
    <a class="btn btn--outline" href={url('services/')}>가공 서비스</a>
    <a class="btn btn--outline" href={url('news/')}>소식</a>
    <a class="btn btn--signal" href={url('quote/')}>견적 문의</a>
  </div></section>
</BaseLayout>
