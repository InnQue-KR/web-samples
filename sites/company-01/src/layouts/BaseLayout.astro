---
/**
 * 공통 틀 4종(Home / Page / NewsList / NewsDetail)의 바깥 껍데기.
 * 머리(noindex·OG) → 본문 건너뛰기 → 샘플 띠 → 머리말 → <main> → (견적 띠) → 바닥글 → 샘플 안내창.
 */
import SampleHead from '@web-samples/sample-kit/SampleHead.astro';
import SampleStrip from '@web-samples/sample-kit/SampleStrip.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CtaBand from '../components/CtaBand.astro';
import SampleNotice from '../components/SampleNotice.astro';
import site from '../data/site.json';
import { url } from '../lib/url';
import '../styles/tokens.css';
import '../styles/site.css';

export type Frame = 'Home' | 'Page' | 'NewsList' | 'NewsDetail';
interface Props {
  frame: Frame;
  /** 메뉴 현재 위치 판단용 경로(base 제외). 예: 'about/' */
  current: string;
  title?: string;
  description?: string;
  /** 하단 견적 띠. 개인정보처리방침·404는 false */
  cta?: boolean;
}
const { frame, current, title = site.seo.title, description = site.seo.description, cta = true } = Astro.props;
---
<!doctype html>
<html lang="ko">
  <head>
    <SampleHead
      title={title}
      description={description}
      siteName={site.seo.siteName}
      themeColor={site.seo.themeColor}
      favicon="images/favicon.svg"
      ogImage={site.seo.ogImage}
      ogImageWidth={site.seo.ogImageWidth}
      ogImageHeight={site.seo.ogImageHeight}
      ogImageAlt={site.seo.ogImageAlt}
    >
      {/* 스크립트가 돌 때만 모바일 메뉴를 접는다(html.js). 사이트 스크립트가 실패해 메뉴가 준비되지 않으면 load 때 다시 펼친 목록으로.
          스타일시트보다 앞에 둔다: 뒤에 두면 CSS를 다 받을 때까지 HTML 해석이 멈춰 LCP가 늦어진다(INNA-644 측정) */}
      <script is:inline>document.documentElement.classList.add('js');addEventListener('load',function(){if(!document.querySelector('[data-menu-ready]'))document.documentElement.classList.remove('js')});</script>
      {/* 글꼴(INNA-653): 화면 글자는 파생본 Doram Sans 한 파일(Pretendard 1.3.9 글리프 서브셋, scripts/make-font-subset.py)로 받는다.
          화면에 쓰인 글자는 모두 파생본에 있다(npm run check가 확인). 공식 Pretendard dynamic-subset은 범위 밖 글자, 곧 방문자가
          입력 칸에 치는 글자용 대체 경로라 첫 로드에는 받지 않고, 입력 칸에 처음 초점이 갈 때 붙인다(이 인라인 스크립트는 사이트
          모듈 스크립트가 실패해도 동작). JS가 꺼져 있으면 noscript로 바로 붙인다. 같은 글자는 파생본 unicode-range에 걸려 공식 조각을 받지 않는다 */}
      {/* 로더도 스타일시트보다 앞에 둔다(뒤에 두면 CSS를 받을 때까지 HTML 해석이 멈추고, WebKit에서는 그림을 다시 요청하는 일이 생김, INNA-653 확인) */}
      <script is:inline define:vars={{ fallbackCss: url('fonts/pretendard/pretendardvariable-dynamic-subset.css') }}>addEventListener('focusin',function f(e){if(!e.target.matches||!e.target.matches('input,textarea,select,[contenteditable]'))return;removeEventListener('focusin',f,true);var l=document.createElement('link');l.rel='stylesheet';l.href=fallbackCss;l.dataset.fontFallback='';document.head.appendChild(l)},true);</script>
      <link rel="preload" href={url('fonts/doram-sans/DoramSans-subset.woff2')} as="font" type="font/woff2" crossorigin />
      <link rel="stylesheet" href={url('fonts/doram-sans/doram-sans.css')} />
      <link rel="stylesheet" href={url('fonts/plex-mono/plex-mono.css')} />
      <noscript><link rel="stylesheet" href={url('fonts/pretendard/pretendardvariable-dynamic-subset.css')} /></noscript>
    </SampleHead>
  </head>
  <body data-frame={frame}>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <SampleStrip class="sample-strip" text={site.notice.topStrip} />
    <SiteHeader current={current} />
    <main id="main" tabindex="-1">
      <slot />
      {cta && <CtaBand />}
    </main>
    <SiteFooter />
    <SampleNotice />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
