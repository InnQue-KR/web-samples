---
const steps = [
  { title: '상담 신청', text: '아래 신청 칸에 남겨 주세요.' },
  { title: '전화 상담', text: '운영 시간 안에 하루 이내로 연락드립니다.' },
  { title: '진단 테스트', text: '40분, 비용 없음. 어느 단원에서 막히는지 확인합니다.' },
  { title: '반 배정과 첫 수업', text: '테스트 결과를 함께 보고 반을 정합니다.' },
];
---
<section data-component="Process" id="process" class="section" aria-labelledby="process-title">
  <div class="container">
    <div class="section__head reveal"><h2 class="section__title" id="process-title">상담부터 첫 수업까지</h2></div>
    <ol class="steps" data-steps>
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">{i + 1}</span>
          <div><h3 class="step__title">{s.title}</h3><p class="step__text">{s.text}</p></div>
          <span class="step__line" style={i < steps.length - 1 ? `--line-delay: ${i * 360}ms` : undefined} aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
</section>
