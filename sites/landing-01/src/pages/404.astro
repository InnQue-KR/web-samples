---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`페이지를 찾을 수 없습니다 | ${site.business.name} (샘플)`}>
  <main id="main" class="section">
    <div class="container">
      <h1 class="section__title">페이지를 찾을 수 없습니다</h1>
      <p class="section__lead">주소가 바뀌었거나 없는 페이지입니다.</p>
      <p style="margin-top: var(--space-6)"><a class="btn btn--primary" href={base}>{site.business.name} 샘플 처음으로</a></p>
    </div>
  </main>
  <footer class="site-footer on-dark"><div class="container"><p class="site-footer__notice">{site.notice.footer}</p></div></footer>
</BaseLayout>
