---
import SampleHead from '@web-samples/sample-kit/SampleHead.astro';
import SampleStrip from '@web-samples/sample-kit/SampleStrip.astro';
import site from '../data/site.json';
import '../styles/tokens.css';
import '../styles/site.css';

interface Props { title?: string; description?: string }
const { title = site.seo.title, description = site.seo.description } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ko">
  <head>
    <SampleHead
      title={title}
      description={description}
      siteName={site.seo.siteName}
      themeColor={site.seo.themeColor}
      favicon="images/favicon.svg"
      ogImage={site.seo.ogImage}
      ogImageWidth={site.seo.ogImageWidth}
      ogImageHeight={site.seo.ogImageHeight}
      ogImageAlt={site.seo.ogImageAlt}
    >
      <link rel="stylesheet" href={`${base}fonts/pretendard/pretendardvariable-dynamic-subset.css`} />
      <script is:inline>
        /* 움직임 줄이기 설정이면 등장 효과용 숨김 상태를 아예 만들지 않는다 */
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      </script>
    </SampleHead>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <SampleStrip text={site.notice.topStrip} />
    <slot />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>
